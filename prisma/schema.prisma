// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  SUPERVISOR
  ADMIN
}

enum StaffStatus {
  AVAILABLE
  BUSY
  BREAK
  OFFLINE
}

enum ContactRequestStatus {
  NEW
  IN_REVIEW
  REJECTED
  CONVERTED
}

enum OrderStatus {
  REQUEST_RECEIVED
  CONSULTATION
  PARTS_SELECTION
  AWAITING_CUSTOMER_CONFIRMATION
  PARTS_ORDERED
  PARTS_ARRIVED
  ASSEMBLY
  WINDOWS_DRIVERS_TESTS
  COMPLETED
  PICKED_UP
  DELIVERED
  PAUSED
}

enum FulfillmentType {
  PICKUP
  SHIPPING
}

enum DocumentType {
  QUOTE
  INVOICE
  OTHER
}

enum InvoiceType {
  INVOICE
  QUOTE
}

enum QuoteStatus {
  OPEN
  ACCEPTED
  REJECTED
}

enum BillingDocType {
  INVOICE
  DELIVERY_NOTE
  DUNNING
}

enum BillingStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  role           Role
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer       Customer?
  staffProfile   StaffProfile?

  createdOrders  Order[]  @relation("CreatedOrders")
  assignedOrders Order[]  @relation("AssignedOrders")

  orderUpdates        OrderUpdate[]
  documents           Document[]
  invitations         Invitation[] @relation("CreatedInvitations")
  chatMessages        ChatMessage[]
  passwordResetTokens PasswordResetToken[]
  createdInvoices     Invoice[]    @relation("CreatedInvoices")
  billingDocs         BillingDocument[] @relation("BillingDocs")
}

model Customer {
  id                String   @id @default(cuid())
  userId            String?  @unique
  customerNumber    String   @unique
  firstName         String
  lastName          String
  email             String
  phone             String
  street            String?
  zipCode           String?
  city              String?
  country           String?
  isActive          Boolean  @default(true)
  notesInternal     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User?    @relation(fields: [userId], references: [id])
  invitations       Invitation[]
  orders            Order[]
  maintenanceContracts MaintenanceContract[]
}

model StaffProfile {
  id          String      @id @default(cuid())
  userId      String      @unique
  displayName String
  position    String?
  status      StaffStatus @default(OFFLINE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id])
}

model Invitation {
  id              String   @id @default(cuid())
  customerId      String
  email           String
  tokenHash       String   @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdByUserId String
  createdAt       DateTime @default(now())

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdByUser   User     @relation("CreatedInvitations", fields: [createdByUserId], references: [id])
}

model ContactRequest {
  id                    String               @id @default(cuid())
  name                  String
  contact               String
  phone                 String?
  subject               String
  message               String
  status                ContactRequestStatus @default(NEW)
  convertedToCustomerId String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model Order {
  id                      String          @id @default(cuid())
  orderNumber             String          @unique
  customerId              String
  title                   String
  description             String?
  status                  OrderStatus     @default(REQUEST_RECEIVED)
  estimatedCompletionDate DateTime?
  finalPrice              Decimal?        @db.Decimal(10, 2)
  currency                String          @default("EUR")
  fulfillmentType         FulfillmentType?
  shippingStatus          String?
  isCompleted             Boolean         @default(false)
  completedAt             DateTime?
  isArchived              Boolean         @default(false)
  archivedAt              DateTime?
  createdByUserId         String
  assignedToUserId        String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  customer                Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdByUser           User            @relation("CreatedOrders", fields: [createdByUserId], references: [id])
  assignedToUser          User?           @relation("AssignedOrders", fields: [assignedToUserId], references: [id])

  parts                   OrderPart[]
  updates                 OrderUpdate[]
  documents               Document[]
  chatMessages            ChatMessage[]
  invoices                Invoice[]
  appointments            OrderAppointment[]
}

model OrderAppointment {
  id          String   @id @default(cuid())
  orderId     String
  title       String
  date        DateTime
  notes       String?
  calendarUid String?
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderPart {
  id           String   @id @default(cuid())
  orderId      String
  name         String
  category     String
  quantity     Int      @default(1)
  unitPrice    Decimal? @db.Decimal(10, 2)
  supplier     String?
  isOrdered    Boolean  @default(false)
  orderedAt    DateTime?
  isArrived    Boolean  @default(false)
  arrivedAt    DateTime?
  trackingInfo String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderUpdate {
  id                  String   @id @default(cuid())
  orderId             String
  authorUserId        String
  title               String
  message             String
  isVisibleToCustomer Boolean  @default(true)
  createdAt           DateTime @default(now())

  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorUser          User     @relation(fields: [authorUserId], references: [id])
}

model Document {
  id                  String       @id @default(cuid())
  orderId             String
  uploadedByUserId    String
  type                DocumentType
  fileName            String
  filePath            String
  mimeType            String?
  isVisibleToCustomer Boolean      @default(false)
  createdAt           DateTime     @default(now())

  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadedByUser      User         @relation(fields: [uploadedByUserId], references: [id])
}

model ChatMessage {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  message   String
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Review {
  id          String   @id @default(cuid())
  name        String
  email       String?
  rating      Int
  text        String
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model Invoice {
  id                String       @id @default(cuid())
  orderId           String
  type              InvoiceType
  number            String       @unique
  createdByUserId   String
  items             Json
  total             Decimal      @db.Decimal(10, 2)
  notes             String?
  isSentToCustomer  Boolean      @default(false)
  sentAt            DateTime?
  dueDate           DateTime?
  quoteStatus       QuoteStatus? @default(OPEN)
  expiresAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  order             Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdByUser     User        @relation("CreatedInvoices", fields: [createdByUserId], references: [id])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  userAgent String?
  ip        String?
  referer   String?
  createdAt DateTime @default(now())
}

model ConfiguratorBuild {
  id           String   @id @default(cuid())
  useCase      String
  budget       String
  cpu          String
  gpu          String
  ram          String
  storage      String
  cooling      String
  pcCase       String
  psu          String
  priceRange   String
  servicePrice String
  note         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([useCase, budget])
}

model MaintenanceContract {
  id              String    @id @default(cuid())
  customerId      String
  title           String
  description     String?
  intervalMonths  Int       @default(12)
  lastServiceDate DateTime?
  nextServiceDate DateTime
  notes           String?
  isActive        Boolean   @default(true)
  reminderSentAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model BillingDocument {
  id               String          @id @default(cuid())
  type             BillingDocType
  number           String          @unique
  status           BillingStatus   @default(DRAFT)

  recipientName    String
  recipientCompany String?
  recipientStreet  String?
  recipientZip     String?
  recipientCity    String?
  recipientEmail   String?

  items            Json
  total            Decimal         @db.Decimal(10, 2)
  notes            String?

  issueDate        DateTime        @default(now())
  dueDate          DateTime?
  deliveryDate     DateTime?

  relatedInvoiceId String?
  relatedInvoice   BillingDocument?  @relation("Dunning", fields: [relatedInvoiceId], references: [id])
  dunnings         BillingDocument[] @relation("Dunning")

  createdByUserId  String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  createdByUser    User            @relation("BillingDocs", fields: [createdByUserId], references: [id])
}

model WiderrufRequest {
  id                  String   @id @default(cuid())
  firstName           String
  lastName            String
  email               String
  orderNumber         String?
  contractDescription String
  confirmedAt         DateTime @default(now())
  emailSentAt         DateTime?
  createdAt           DateTime @default(now())
}
